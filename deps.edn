{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.kotoba-lang/kotoba-hir
        {:git/url "https://github.com/kotoba-lang/kotoba-hir.git"
         :git/sha "390ba7735747ad12bc865ad9e647b0982a2a09e4"}
        io.github.kotoba-lang/security
        {:git/url "https://github.com/kotoba-lang/security.git"
         :git/sha "b13c5e12b488c6e5438f2a2a647f1853ebebd4bf"}
        ;; DefCID is CIDv1 over a real deterministic DAG-CBOR block. These
        ;; are the same pins used by the former language-repository authority;
        ;; extraction must preserve every existing golden byte and CID.
        ;; The portable SHA-256 behind `document-sha256` on ClojureScript.
        ;; Named directly rather than reached through io-multiformats, whose
        ;; own `:cljs` sha256 requires the npm package `@noble/hashes`.
        io.github.kotoba-lang/org-nist-sha2
        {:git/url "https://github.com/kotoba-lang/org-nist-sha2.git"
         :git/sha "cb67e53e590e0999d741523797729a3d747cda95"}
        io.github.kotoba-lang/io-multiformats
        {:git/url "https://github.com/kotoba-lang/io-multiformats.git"
         :git/sha "eec3ee85c458ea830be94518b9a42f4a8f1aee40"}
        io.github.kotoba-lang/dag-cbor
        {:git/url "https://github.com/kotoba-lang/dag-cbor.git"
         :git/sha "58144e81ccdf7a82367085c66ea21ca84a1a7ddb"}}
 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/url "https://github.com/cognitect-labs/test-runner.git"
                                :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
                  :main-opts ["-m" "cognitect.test-runner"]}}}
