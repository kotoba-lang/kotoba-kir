{:paths ["src" "resources"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.kotoba-lang/kotoba-hir
        {:git/url "https://github.com/kotoba-lang/kotoba-hir.git"
         :git/sha "390ba7735747ad12bc865ad9e647b0982a2a09e4"}
        io.github.kotoba-lang/security
        {:git/url "https://github.com/kotoba-lang/security.git"
         :git/sha "b13c5e12b488c6e5438f2a2a647f1853ebebd4bf"}
        ;; DefCID is CIDv1 over a real deterministic DAG-CBOR block. These
        ;; are the same pins used by the former language-repository authority;
        ;; extraction must preserve every existing golden byte and CID.
        ;; The portable SHA-256 behind `document-sha256` on ClojureScript.
        ;; Named directly rather than reached through io-multiformats, whose
        ;; own `:cljs` sha256 requires the npm package `@noble/hashes`.
        io.github.kotoba-lang/org-nist-sha2
        {:git/url "https://github.com/kotoba-lang/org-nist-sha2.git"
         :git/sha "cb67e53e590e0999d741523797729a3d747cda95"}
        io.github.kotoba-lang/io-multiformats
        {:git/url "https://github.com/kotoba-lang/io-multiformats.git"
         :git/sha "eec3ee85c458ea830be94518b9a42f4a8f1aee40"}
        io.github.kotoba-lang/org-ietf-cbor
        {:git/url "https://github.com/kotoba-lang/org-ietf-cbor.git"
         :git/sha "58144e81ccdf7a82367085c66ea21ca84a1a7ddb"}}
 :aliases {:test {:extra-paths ["test"]
                  ;; TEST ONLY, deliberately. Root ADR
                  ;; adr-2609076000-kir-is-an-ipld-codec-schema-and-adl decided
                  ;; the canonical bytes should come from io-ipld; this pin is
                  ;; here to MEASURE the gap to kotoba.value.v1, not to have
                  ;; crossed it. Promoting it to :deps is the payload v3
                  ;; decision, because every frozen vector disagrees today --
                  ;; see kotoba.kir-value-codec-differential-test. Acyclic:
                  ;; io-ipld depends only on dev-protobuf, io-multiformats and
                  ;; org-ietf-cbor, the last two of which are already above.
                  ;; io-ipld needs `multiformats.base32`, which this
                  ;; repository's top-level io-multiformats pin predates (it is
                  ;; 37 commits behind that repository's main as of 2026-09-07).
                  ;; A top-level dep wins over a transitive one in tools.deps,
                  ;; so the older pin would be chosen and `ipld.link` would not
                  ;; load. Overridden HERE rather than at the top level: moving
                  ;; the runtime pin is a separate change with its own risk, and
                  ;; the frozen-CID assertions in the differential test double
                  ;; as evidence that these 37 commits do not move CID assembly.
                  :override-deps {io.github.kotoba-lang/io-multiformats
                                  {:git/url "https://github.com/kotoba-lang/io-multiformats.git"
                                   :git/sha "561fe7dfada3db852b127f06d41750dabd3cead9"}}
                  :extra-deps {io.github.kotoba-lang/io-ipld
                               {:git/url "https://github.com/kotoba-lang/io-ipld.git"
                                :git/sha "973e26a521465d0fdec89cf28fd9a6224830ce36"}
                               io.github.cognitect-labs/test-runner
                               {:git/url "https://github.com/cognitect-labs/test-runner.git"
                                :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
                  :main-opts ["-m" "cognitect.test-runner"]}}}
